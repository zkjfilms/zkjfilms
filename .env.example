# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed — see .gitignore's `.env*` rule.

# Resend API key — get yours from https://resend.com/api-keys
RESEND_API_KEY=

# Password for /gated. Set the same value in Vercel's Production/Preview env vars.
GATED_ACCESS_PASSWORD=

# Cloudflare R2 (S3-compatible storage) for the client gallery feature.
# From the Cloudflare dashboard: R2 > Manage API tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET_NAME=

# Same Cloudflare account, separate bucket: public site/marketing images
# (see lib/media.ts and scripts/uploadImage.mjs). Use a scoped API token
# with Object Read & Write on just this bucket.
R2_PUBLIC_ACCESS_KEY_ID=
R2_PUBLIC_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET_NAME=

# Anthropic API key for AI-suggested alt text in scripts/uploadImage.mjs — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Supabase for the client gallery feature. Service role key — server-side
# only, never expose to the browser. From Project Settings > API.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Public — inlined into the browser bundle by Next.js, so treat it as
# published. Used only for Realtime Broadcast subscriptions
# (lib/supabaseBrowser.ts), which don't require table grants. It is not a
# service-role key, but it is NOT harmless on its own either: Supabase
# grants the `anon` role access to public-schema tables by default, so
# what actually keeps this key from reading/writing data is Row Level
# Security being enabled (with no policies) on every table — see the RLS
# block at the end of supabase/schema.sql. Any new table must get RLS
# enabled there before it exists in production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Password for /admin/galleries (read-only gallery list). Set the same
# value in Vercel's Production/Preview env vars.
ADMIN_PASSWORD=

# Stripe — Developers > API keys for the secret key, Developers >
# Webhooks for the signing secret of the endpoint pointing at
# /api/webhooks/stripe-bookings (see the Stripe CLI setup note in
# docs/superpowers/specs/2026-08-02-booking-deposits-reschedule-cancellation-design.md
# for local development).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET_BOOKINGS=

# Google Calendar OAuth2 — from Google Cloud Console > APIs & Services >
# Credentials. Redirect URI must be added there too and must exactly
# match GOOGLE_OAUTH_REDIRECT_URI (including http vs https and trailing
# slash).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/admin/google/callback

# YouTube Data API v3 — a plain API key (not OAuth), from the same Google
# Cloud project as the vars above. Used by lib/podcast.ts to pair /podcast's
# RSS episodes with their YouTube videos. Optional: if unset, /podcast still
# works, episodes just render without a video embed (audio-only fallback).
YOUTUBE_API_KEY=

# Verifies the request to /api/cron/sync-google-calendar — any random
# secret string. Sent as `Authorization: Bearer <value>` by the GitHub
# Actions workflow (.github/workflows/sync-google-calendar.yml, which
# also needs this same value set as a repo secret via `gh secret set
# CRON_SECRET`), not Vercel's own Cron — see that workflow's comment for
# why.
CRON_SECRET=

# Signs the short-lived token issued by /api/gallery-access once a
# client unlocks a gallery, so /api/gallery-access/favorite can verify
# heart-toggle requests without re-checking the gallery password (which
# uses bcrypt, deliberately slow) on every click. Any random secret
# string — generate with `openssl rand -hex 32`. Distinct from
# ADMIN_PASSWORD/CRON_SECRET since it guards a different trust boundary
# (one gallery's favorites, not admin or cron access). Set the same
# value in Vercel's Production/Preview env vars before deploying.
GALLERY_FAVORITE_TOKEN_SECRET=

# Cloudflare Turnstile (bot verification on /contact and /book). Create a
# widget at the Cloudflare dashboard > Turnstile > Add widget, Managed
# mode, with zkjfilms.com and localhost as allowed domains. Set the same
# two values in Vercel's Production/Preview env vars before deploying.
#
# For local development before you have real keys, Cloudflare's fixed
# test keys work end-to-end without needing a real widget:
#   Always passes: site=1x00000000000000000000AA secret=1x0000000000000000000000000000000AA
#   Always blocks: site=2x00000000000000000000AB secret=2x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
